// Prisma Schema 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELS (Database Tables)
// ==========================================

model Lead {
  id              String    @id @default(cuid())  // Primary key
  firstName       String
  lastName        String
  email           String    @unique               // Must be unique
  phone           String?                         // Optional
  company         String?
  position        String?
  linkedinUrl     String?
  socials         String?
  source          String
  enrichmentData  Json?                          // Flexible JSON field
  score           Int?
  description     String?
  status          String    @default("new")
  campaignId      String?
  icpId           String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])  // Foreign key
  icp             ICP?      @relation(fields: [icpId], references: [id] )
  messages        Message[]                       // One-to-many
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([phone])   // Index for fast lookups
  @@index([status])
  @@index([icpId])
  @@index([score])
}

model Campaign {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     @default("draft")
  leads       Lead[]                             // One-to-many
  sequences   Sequence[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Sequence {
  id          String   @id @default(cuid())
  name        String
  steps       Json                                // Array of steps
  description String?
  prompt      String?
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id])
  content           String
  direction         String                               // 'inbound' or 'outbound'
  channel           String                               // 'whatsapp' or 'email'
  status            String   @default("sent")
  trengoMessageId   String? // Trengo's ID for tracking
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([status])
}

model ICP {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  criteria  Json                                 // Flexible criteria
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}