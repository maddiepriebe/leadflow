// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELS (Database Tables)
// ==========================================

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          String    @default("user")  // "admin", "user", "viewer"
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ==========================================
// LEADS
// ==========================================

model Lead {
  id              String    @id @default(cuid())  // Primary key
  firstName       String
  lastName        String
  email           String    @unique               // Must be unique
  phone           String?                         // Optional
  company         String?
  position        String?
  linkedinUrl     String?
  socials         String?
  source          String
  enrichmentData  Json?                          // Flexible JSON field
  score           Int?
  description     String?
  status          String    @default("new")
  campaignId      String?
  icpId           String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])  // Foreign key
  icp             ICP?      @relation(fields: [icpId], references: [id] )
  messages        Message[]                       // One-to-many
  sequenceEnrollments SequenceEnrollment[]        // Sequences this lead is enrolled in
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  currentScore    Float?
  lastScoredAt    DateTime?
  scores          LeadScore[]
  conversions     ConversionEvent[]

  @@index([phone])   // Index for fast lookups
  @@index([status])
  @@index([icpId])
  @@index([score])
}

model Campaign {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     @default("draft")
  leads       Lead[]                             // One-to-many
  sequences   Sequence[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Sequence {
  id          String   @id @default(cuid())
  name        String
  steps       Json                                // Array of steps
  description String?
  prompt      String?
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  status      String   @default("draft")          // "draft", "active", "paused", "completed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  enrollments SequenceEnrollment[]

  @@index([status])
}

// ==========================================
// SEQUENCE EXECUTION
// ==========================================

model SequenceEnrollment {
  id              String    @id @default(cuid())
  sequenceId      String
  sequence        Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  currentStepIndex Int      @default(0)           // Which step they're on (0-indexed)
  status          String    @default("active")    // "active", "paused", "completed", "failed", "unsubscribed"
  nextStepAt      DateTime?                       // When to execute next step
  completedAt     DateTime?
  pausedAt        DateTime?
  enrolledAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Track individual step executions
  stepExecutions  StepExecution[]

  @@unique([sequenceId, leadId])                  // A lead can only be enrolled once per sequence
  @@index([sequenceId])
  @@index([leadId])
  @@index([status])
  @@index([nextStepAt])
}

model StepExecution {
  id              String    @id @default(cuid())
  enrollmentId    String
  enrollment      SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepIndex       Int                              // Which step was executed
  status          String    @default("pending")   // "pending", "sent", "delivered", "opened", "clicked", "replied", "bounced", "failed"
  messageId       String?                          // Reference to Message if sent
  message         Message?  @relation(fields: [messageId], references: [id])
  scheduledFor    DateTime
  executedAt      DateTime?
  error           String?                          // Error message if failed
  createdAt       DateTime  @default(now())

  @@index([enrollmentId])
  @@index([status])
  @@index([scheduledFor])
}

model Message {
  id                String   @id @default(cuid())
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id])
  content           String
  direction         String                               // 'inbound' or 'outbound'
  channel           String                               // 'whatsapp' or 'email'
  status            String   @default("sent")
  trengoMessageId   String?                              // Trengo's ID for tracking
  sentAt            DateTime @default(now())
  createdAt         DateTime @default(now())

  // Track which sequence step this message came from
  stepExecutions    StepExecution[]

  @@index([leadId])
  @@index([status])
}

model ICP {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  criteria  Json                                 // Flexible criteria
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SCORING MODEL
// ==========================================
// Lead scoring configuration

model ScoringModel {
  id          String   @id @default(cuid())
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  weights     Json     // { "hasEmail": 10, "hasPhone": 8, "companySize": 5, ... }
  createdAt   DateTime @default(now())
  
  // Performance metrics
  totalScored       Int @default(0)
  totalConverted    Int @default(0)
  avgConvertedScore Float @default(0)
}

// Track scoring history for each lead
model LeadScore {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id])
  score         Float
  breakdown     Json     // { "hasEmail": 10, "matchesICP": 15, ... }
  modelVersion  Int
  scoredAt      DateTime @default(now())
  
  @@index([leadId])
  @@index([score])
}

// Track conversion events
model ConversionEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String   // "reply", "qualified", "converted", "meeting_booked"
  channel   String?  // "email", "whatsapp", "instagram"
  metadata  Json?
  createdAt DateTime @default(now())
  
  @@index([leadId])
  @@index([type])
}