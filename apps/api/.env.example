PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username@localhost:5432/leadgen"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (for authentication)
JWT_SECRET=secret-key-change-this-in-production

# ==========================================
# ENRICHMENT API PROVIDERS
# ==========================================
# Configure at least one provider for lead enrichment.
# The system will use the first available provider in this priority:
# 1. Apollo  2. Clearbit  3. People Data Labs  4. Hunter

# Apollo.io - https://www.apollo.io/
# Provides: Person + Company enrichment, email verification
APOLLO_API_KEY=your-apollo-api-key

# Clearbit - https://clearbit.com/
# Provides: Person + Company enrichment with detailed firmographics
CLEARBIT_API_KEY=your-clearbit-api-key

# People Data Labs - https://www.peopledatalabs.com/
# Provides: Person + Company enrichment with skills data
PDL_API_KEY=your-pdl-api-key

# Hunter.io - https://hunter.io/
# Provides: Email finder + verification, basic person data
HUNTER_API_KEY=your-hunter-api-key

# ==========================================
# OTHER EXTERNAL APIS
# ==========================================

# Google API Key - CSE and Places
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CSE_ID=your-custom-search-engine-id

# Trengo (messaging)
TRENGO_API_KEY=your-trengo-api-key

# OpenAI (for AI message generation)
OPENAI_API_KEY=your-openai-api-key
