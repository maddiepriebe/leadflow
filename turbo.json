{
    "$schema":"https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*local"],
    "tasks":{
        "dev":{
            "cache":false,
            "persistent":true
        },
        "workers": {
            "cache": false,
            "persistent": true
        },
        "build":{
            "dependsOn":["^build"],
            "outputs":["dist/**",".next/**"]
        },
        "lint":{
            "outputs":[]
        },
        "clean":{
            "cache":false
        }
    }
}
